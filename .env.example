# Isay copy karke .env banayein:  cp .env.example .env
# .env git me nahi jati — asli values sirf wahan daalein.
#
# Har machine/server ki apni values hongi:
#   - local / testing  -> test cluster ki URI
#   - production       -> production cluster ki URI (server par set hogi, repo me nahi)
#
# MONGODB_URI set na ho to app start hone se inkar kar degi.
# Ye jaan boojh kar hai, taake galti se ghalat database se connect na ho jaye.

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/Inventrymanagement?retryWrites=true&w=majority

JWT_SECRET_KEY=yahan-ek-lamba-random-secret-daalein
